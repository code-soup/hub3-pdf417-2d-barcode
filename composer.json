{
    "name": "codesoup/hub3-pdf417-2d-barcode",
    "description": "Modern PHP 8.2+ library for generating PDF417 2D barcodes, optimized for Croatian HUB-3 banking payment slips",
    "license": "MIT",
    "keywords": ["barcode", "pdf417", "2d-barcode", "hub3", "hub-3", "croatian-banking", "payment-slip", "generator"],
    "authors": [
        {
            "name": "Ivan Habunek",
            "email": "ivan.habunek@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "CodeSoup",
            "role": "Maintainer (PHP 8.2+ Fork)"
        }
    ],
    "autoload": {
        "psr-4": {
            "BigFish\\PDF417\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BigFish\\PDF417\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-bcmath": "*",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    }
}
