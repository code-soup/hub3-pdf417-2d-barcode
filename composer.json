{
    "name": "codesoup/pdf417",
    "description": "A library for generating PDF417 barcodes in PHP 8.2+ (Modernized fork of bigfish/pdf417)",
    "license": "MIT",
    "keywords": ["barcode", "pdf417", "2d-barcode", "generator"],
    "authors": [
        {
            "name": "Ivan Habunek",
            "email": "ivan.habunek@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "CodeSoup",
            "role": "Maintainer (PHP 8.2+ Fork)"
        }
    ],
    "autoload": {
        "psr-4": {
            "BigFish\\PDF417\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BigFish\\PDF417\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-bcmath": "*",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    }
}
